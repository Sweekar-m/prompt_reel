# REEL STUDIO Environment Configuration
# ====================================

# [OPTIONAL] NVIDIA NIM Nemotron API Key for cloud LLM reasoning
# Get your API key from: https://build.nvidia.com
# If left empty, Reel Studio runs seamlessly on its built-in offline deterministic expert engine!
NVIDIA_NIM_API_KEY=

# NVIDIA NIM Base URL & Model Name
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=meta/llama-3.2-11b-vision-instruct

# Web Studio Server Port (Default: 5055)
REEL_PORT=5055
